# Sourced by kamal for every destination; later assignments win.
# A classic token with only the write:packages scope: Kamal logs every host in to ghcr.io with
# it, so it stays on them. Not `gh auth token`, which can do anything your account can.
KAMAL_REGISTRY_PASSWORD=$(cat ~/.config/stvtf/ghcr.token)
# Shared with serveme.tf, which makes the start links. Generate once with
# `openssl rand -hex 32 > ~/.config/stvtf/token.key`.
STVTF_TOKEN_KEY=$(cat ~/.config/stvtf/token.key)
# The voice bot's key, shared with it (stvtf-voice-bot) and by every region. Generate once with
# `openssl rand -hex 32 > ~/.config/stvtf/voice.key`. Empty while there is none: no voice taken in.
STVTF_VOICE_KEY=$(cat ~/.config/stvtf/voice.key 2>/dev/null)
# The Discord application people link Steam through (OAuth2: client id and secret), for Europe.
# Empty while there are none: no linking.
STVTF_DISCORD_CLIENT_ID=$(cat ~/.config/stvtf/discord-client.id 2>/dev/null)
STVTF_DISCORD_CLIENT_SECRET=$(cat ~/.config/stvtf/discord-client.secret 2>/dev/null)
