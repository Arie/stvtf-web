# Sourced by kamal for every destination; later assignments win.
# A classic token with only the write:packages scope: Kamal logs every host in to ghcr.io with
# it, so it stays on them. Not `gh auth token`, which can do anything your account can.
KAMAL_REGISTRY_PASSWORD=$(cat ~/.config/stvtf/ghcr.token)
# Shared with serveme.tf, which makes the start links. Generate once with
# `openssl rand -hex 32 > ~/.config/stvtf/token.key`.
STVTF_TOKEN_KEY=$(cat ~/.config/stvtf/token.key)
