#!/bin/sh
# Runs CI's quick checks before each commit: all but cargo test (it builds the tests and wants the
# maps in testdata/maps) and cargo deny (it fetches the advisory database).
# Enable once per clone with: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit
set -e
cargo fmt --check || { echo "pre-commit: run 'cargo fmt' to fix formatting"; exit 1; }
cargo clippy --all-targets --quiet -- -D warnings
[ -d node_modules ] || { echo "pre-commit: run 'npm ci' once to install ESLint, Prettier and TypeScript"; exit 1; }
npm run --silent format:check || { echo "pre-commit: run 'npm run format' to fix formatting"; exit 1; }
npm run --silent lint
npm run --silent typecheck
npm test --silent >/dev/null || { npm test; exit 1; }
