#!/bin/sh
# Runs CI's quick checks before each commit, in parallel: all but cargo test (it builds the tests
# and wants the maps in testdata/maps) and cargo deny (it fetches the advisory database).
# Enable once per clone with: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit
exec "$(git rev-parse --show-toplevel)/script/test" --parallel --skip cargo-test,cargo-deny
