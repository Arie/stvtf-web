#!/usr/bin/env bash
# Deploy the checked-out commits to the given region(s). The image must already be pushed
# (run bin/build first).
#
# Usage:
#   bin/deploy            # all four regions in parallel
#   bin/deploy eu         # one region
#   bin/deploy eu na      # a subset, in parallel
set -euo pipefail
cd "$(dirname "$0")/.."

# With uncommitted changes in either checkout, every Kamal run picks a fresh random version,
# so a deploy would look for an image bin/build never pushed. Pass the built one as VERSION.
if [[ -z "${VERSION:-}" ]] && [[ -n "$(git status --porcelain)$(git -C ../stvtf status --porcelain)" ]]; then
  echo "Uncommitted changes in stvtf-web or stvtf: set VERSION to the tag bin/build pushed." >&2
  exit 1
fi

regions=("$@")
[[ ${#regions[@]} -eq 0 ]] && regions=(eu na au sea)

version=${VERSION:-$(git rev-parse --short=12 HEAD)_stvtf_$(git -C ../stvtf rev-parse --short=12 HEAD)}

# `kamal deploy` fails when its image prune does, which happens while the relay uses an older
# image. The deploy itself succeeded if the app runs this version.
deploy() {
  kamal deploy --skip-push -d "$1" && return
  if kamal app version -d "$1" 2>/dev/null | grep -qxF "$version"; then
    echo "$1: runs $version; Kamal's clean-up failed (the relay's image is in use)" >&2
  else
    return 1
  fi
}

pids=()
for d in "${regions[@]}"; do
  deploy "$d" &
  pids+=($!)
done
status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
