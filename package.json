{
  "name": "stvtf-web",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint app test script",
    "format": "prettier --write \"app/**/*.js\" \"test/**/*.js\" \"script/**/*.mjs\" \"types/**/*.ts\" eslint.config.mjs",
    "format:check": "prettier --check \"app/**/*.js\" \"test/**/*.js\" \"script/**/*.mjs\" \"types/**/*.ts\" eslint.config.mjs",
    "typecheck": "tsc -p .",
    "test": "node --import ./test/js/setup.js --test \"test/js/*.test.js\"",
    "test:browser": "node --test \"test/browser/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
